{
  "expo": {
    "name": "Arshia TV",
    "slug": "bardiavpn",
    "owner": "bardiavpn1s-team",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0E17",
    "runtimeVersion": "snapp-sdk52-v1",
    "updates": {
      "url": "https://expo.dev",
      "enabled": true,
      "checkAutomatically": "ON_START",
      "fallbackToCacheTimeout": 30000
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.snapp.arshiatv",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "برای انتخاب ویدیو از گالری",
        "NSCameraUsageDescription": "برای ضبط ویدیو",
        "UIBackgroundModes": [
          "audio"
        ],
        "UIDeviceFamily": [
          1,
          2,
          3
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E17"
      },
      "package": "com.snapp.arshiatv",
      "isTV": true,
      "intentFilters": [
        {
          "action": "android.intent.action.MAIN",
          "categories": [
            "android.intent.category.LAUNCHER",
            "android.intent.category.LEANBACK_LAUNCHER"
          ]
        }
      ],
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#0A0E17"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "برای انتخاب ویدیو از گالری",
          "cameraPermission": "برای ضبط ویدیو"
        }
      ]
    ],
    "extra": {
      "firebaseUrl": "https://arshiyatv-59a63-default-rtdb.firebaseio.com",
      "eas": {
        "projectId": "741dfdd2-b20e-4721-8163-60a2916232d9"
      }
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A0E17"
    }
  }
}
