{
  "expo": {
    "name": "Arshia TV",
    "slug": "arshia-tv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0E17",
    "runtimeVersion": "snapp-sdk57-v1",
    "updates": {
      "url": "https://u.expo.dev/{EAS_PROJECT_ID}"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.snapp.arshiatv",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E17"
      },
      "package": "com.snapp.arshiatv"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "acf108fd-0f96-4bfc-b801-e7df391771c5"
      }
    }
  }
}
