rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Ads assets: only admins can write
    match /ads/{allPaths=**} {
      allow read: if true;
      // Prefer custom claims (admin:true). If you don't set custom claims, replace the check
      // with `request.auth != null && request.auth.uid == "YOUR_UID"` for quick setup.
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Posters: public read, only admins write
    match /posters/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Default: allow read, deny write
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
